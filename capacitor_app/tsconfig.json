{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        // "moduleResolution": "node",
        "declaration": true,
        "outDir": "www/dist",
        "skipLibCheck": true,
        "paths": {
            "shoelace/*": [
                "./www/deps/shoelace-2.20.1/*"
            ]
        },
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
    },
    "include": [
        "www/src/**/*"
    ],
}